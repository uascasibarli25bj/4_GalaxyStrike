--- !u!114 &121797704
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 121797702}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4361335f1e182ad47a6fa07751fb4212, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueLines
  messageList:
  - author: Nehpets
    message: We're glad to have you here lieutenant.  We could really use your help!
    authorColor: {r: 0.18111429, g: 0.4858738, b: 0.6981132, a: 1}
  - author: Nehpets
    message: Like shooting fish in a barrel!
    authorColor: {r: 0.18039216, g: 0.4862745, b: 0.69803923, a: 0}
  - author: Nehpets
    message: It's a trap!  Get out of there.
    authorColor: {r: 0.18039216, g: 0.4862745, b: 0.69803923, a: 0}
  - author: Kcir
    message: Crikey!  Looks like you could use a hand.
    authorColor: {r: 0.7075472, g: 0.7075472, b: 0.7075472, a: 1}
  - author: Nehpets
    message: Never thought I'd see your face around here general...
    authorColor: {r: 0.18039216, g: 0.4862745, b: 0.69803923, a: 1}
  - author: Kcir
    message: Righteo let's finish this once and for all.
    authorColor: {r: 0.70980394, g: 0.70980394, b: 0.70980394, a: 1}
  - author: Kcir
    message: Struth!  Looks like the galaxy just got a little more safe.
    authorColor: {r: 0.70980394, g: 0.70980394, b: 0.70980394, a: 1}
  - author: Nehpets
    message: Yeeeehaw!!  You did it!
    authorColor: {r: 0.18039216, g: 0.4862745, b: 0.69803923, a: 0}
  dialogueText: {fileID: 890350875}
